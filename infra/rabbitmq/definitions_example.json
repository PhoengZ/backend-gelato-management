{
  "rabbit_version": "3.13",
  "rabbitmq_version": "3.13",
  "users": [
    {
      "name": "publisher_service",
      "password_hash": "replace_with_generated_hash",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": []
    },
    {
      "name": "consumer_service",
      "password_hash": "replace_with_generated_hash",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": []
    }
  ],
  "vhosts": [
    {
      "name": "gelato_vhost"
    }
  ],
  "permissions": [
    {
      "user": "publisher_service",
      "vhost": "gelato_vhost",
      "configure": "^domain_exchange$",
      "write": "^domain_exchange$",
      "read": "^$"
    },
    {
      "user": "consumer_service",
      "vhost": "gelato_vhost",
      "configure": "^(domain_exchange|consumer_queue)$",
      "write": "^(domain_exchange|consumer_queue)$",
      "read": "^(domain_exchange|consumer_queue)$"
    }
  ],
  "policies": [],
  "queues": [],
  "exchanges": [],
  "bindings": []
}
