# Core RabbitMQ Admin Credentials
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=secure_admin_password

# Development service credentials matching infra/rabbitmq/definitions.json.
# These variables are references for service .env files, not broker interpolation.
ANALYTICS_RABBITMQ_PASSWORD=password123
INVENTORY_RABBITMQ_PASSWORD=inventory_dev_password
FULFILLMENT_RABBITMQ_PASSWORD=fulfillment_dev_password
NOTIFICATION_RABBITMQ_PASSWORD=notification_dev_password
ORDER_RABBITMQ_PASSWORD=order_dev_password

# Auth Service PostgreSQL
AUTH_POSTGRES_DB=gelatoflow_auth
AUTH_POSTGRES_USER=auth_service
AUTH_POSTGRES_PASSWORD=auth_dev_password

# Batch Inventory Service PostgreSQL
INVENTORY_POSTGRES_DB=gelatoflow_inventory
INVENTORY_POSTGRES_USER=inventory_service
INVENTORY_POSTGRES_PASSWORD=inventory_db_dev_password

# Fulfillment Service PostgreSQL
FULFILLMENT_POSTGRES_DB=gelatoflow_fulfillment
FULFILLMENT_POSTGRES_USER=fulfillment_service
FULFILLMENT_POSTGRES_PASSWORD=fulfillment_db_dev_password

# Fulfillment Service RabbitMQ URL (user defined in infra/rabbitmq/definitions.json)
FULFILLMENT_RABBITMQ_URL=amqp://fulfillment_service:fulfillment_dev_password@rabbitmq:5672/gelato_vhost

# Notification Service (stateless: no database). RabbitMQ user is defined in infra/rabbitmq/definitions.json.
NOTIFICATION_RABBITMQ_URL=amqp://notification_service:notification_dev_password@rabbitmq:5672/gelato_vhost
# Must match the Auth Service signing secret and be at least 32 bytes.
NOTIFICATION_JWT_SECRET=replace_with_the_auth_signing_secret_at_least_32_bytes
# Order Service PostgreSQL
ORDER_POSTGRES_DB=gelatoflow_order
ORDER_POSTGRES_USER=order_service
ORDER_POSTGRES_PASSWORD=order_db_dev_password

# Catalog Service Redis
CATALOG_REDIS_PASSWORD=catalog_dev_password

# Analytics Service MongoDB
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=test

# Shared JWT Configuration (Auth, Gateway, Catalog, Inventory, Notifications, Analytics)
JWT_SECRET=development_only_change_this_secret_32_bytes
JWT_ISSUER=gelatoflow-auth
JWT_AUDIENCE=gelatoflow-api

# Inter-Service Machine Tokens (at least 32 bytes)
ORDER_SERVICE_TOKEN=order_service_token_at_least_32_bytes_long
PAYMENT_SERVICE_TOKEN=payment_service_token_at_least_32_bytes_long
PAYMENT_REQUEST_TOKEN=payment_request_token_at_least_32_bytes

# Stripe Test Credentials
STRIPE_SECRET_KEY=sk_test_dummy_key_for_testing
STRIPE_WEBHOOK_SECRET=whsec_test_secret_for_integration_testing_12345
