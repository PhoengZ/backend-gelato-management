{
  "info": {
    "name": "GelatoFlow Round 2 Auth only",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Real Auth login/me for Customer, Staff and Manager. Import the local .local/postman.environment.json generated by demo.py seed. Contains placeholders only; do not share the private environment."
  },
  "item": [
    {
      "name": "01 Customer login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{authBaseUrl}}/api/v1/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Real Auth login returns 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"Expected role\", () => pm.expect(body.user.role).to.eql(\"CUSTOMER\"));",
              "  pm.environment.set(\"customerToken\", body.access_token);",
              "  pm.environment.set(\"customerId\", body.user.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 CUSTOMER identity",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{authBaseUrl}}/api/v1/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Identity returns 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"Role matches\", () => pm.expect(body.role).to.eql(\"CUSTOMER\"));",
              "  pm.test(\"UUID matches login\", () => pm.expect(body.id).to.eql(pm.environment.get(\"customerId\")));",
              "}"
            ]
          }
        }
      ]
    },
