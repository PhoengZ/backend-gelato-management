    {
      "name": "09 Public signup rejects privileged role",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"rejected-auth-demo@example.test\",\n  \"password\": \"demo-invalid-role-password\",\n  \"display_name\": \"Rejected privileged signup\",\n  \"role\": \"MANAGER\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{authBaseUrl}}/api/v1/auth/signup"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Role injection returns 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
