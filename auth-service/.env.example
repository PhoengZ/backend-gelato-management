GO_ENV=development
PORT=3001
DATABASE_URL=postgres://auth_service:auth_dev_password@localhost:5433/gelatoflow_auth?sslmode=disable
JWT_SECRET=development_only_change_this_secret_32_bytes
JWT_ISSUER=gelatoflow-auth
JWT_AUDIENCE=gelatoflow-api
JWT_TTL=15m
BCRYPT_COST=12
REQUEST_TIMEOUT=5s

# Optional HTTPS; configure both mounted PEM files together.
HTTP_TLS_CERT_FILE=
HTTP_TLS_KEY_FILE=

# Optional Auth outbox publisher. Keep disabled until its event/routing is agreed.
# The exchange and durable receiving queue/binding must already exist.
OUTBOX_PUBLISH_ENABLED=false
OUTBOX_AMQP_URL=
OUTBOX_EXCHANGE=
OUTBOX_POLL_INTERVAL=1s
OUTBOX_PUBLISH_TIMEOUT=5s
# Optional extra CA for AMQPS; system CA/hostname verification remains enabled.
OUTBOX_TLS_CA_FILE=
