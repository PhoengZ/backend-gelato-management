PORT=8080

# Must be the same signing secret Auth Service uses (at least 32 bytes).
JWT_SECRET=replace_with_the_auth_signing_secret_at_least_32_bytes
JWT_ISSUER=gelatoflow-auth
JWT_AUDIENCE=gelatoflow-api

# Optional: leave blank to run without RabbitMQ (the SSE endpoint still serves, nothing is pushed).
# Shared dev broker (infra compose.dev.yml): vhost gelato_vhost, user from definitions.json.
RABBITMQ_URL=amqp://notification_service:notification_dev_password@localhost:5672/gelato_vhost

# How long an order_id -> customer_id mapping from order.placed is kept (routes order.ready / order.cancelled).
ORDER_OWNER_TTL=24h
# SSE keep-alive comment interval.
HEARTBEAT_INTERVAL=25s
