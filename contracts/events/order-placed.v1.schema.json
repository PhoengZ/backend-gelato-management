{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gelatoflow.example/contracts/events/order-placed.v1.schema.json",
  "title": "GelatoFlow OrderPlaced v1 CloudEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "const": "/gelatoflow/order-service"
    },
    "type": {
      "const": "com.gelatoflow.order.placed.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_id",
        "customer_id",
        "status",
        "pickup_at",
        "total_amount_minor",
        "currency",
        "items"
      ],
      "properties": {
        "order_id": {
          "type": "string",
          "format": "uuid"
        },
        "customer_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "const": "PAID"
        },
        "pickup_at": {
          "type": "string",
          "format": "date-time"
        },
        "total_amount_minor": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "description": "Paid total in the currency's minor unit; satang when currency is THB."
        },
        "currency": {
          "const": "THB"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "flavor_id",
              "flavor_name",
              "portions",
              "unit_price_minor",
              "subtotal_minor"
            ],
            "properties": {
              "flavor_id": {
                "type": "string",
                "format": "uuid"
              },
              "flavor_name": {
                "type": "string",
                "minLength": 1
              },
              "portions": {
                "type": "integer",
                "minimum": 1
              },
              "unit_price_minor": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "subtotal_minor": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
