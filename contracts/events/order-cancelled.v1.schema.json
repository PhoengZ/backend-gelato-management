{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gelatoflow.example/contracts/events/order-cancelled.v1.schema.json",
  "title": "GelatoFlow OrderCancelled v1 CloudEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "const": "/gelatoflow/order-service"
    },
    "type": {
      "const": "com.gelatoflow.order.cancelled.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_id",
        "reason"
      ],
      "properties": {
        "order_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Stable reason code owned by Order Service. Current codes: ORDER_CANCELLED (customer request, verified payment failure or a payment rejected after stock expiry), RESERVATION_EXPIRED (unpaid order whose stock hold passed its deadline) and STORE_CANCELLED (staff or manager cancelled a paid order before preparation). Consumers must tolerate new codes."
        },
        "customer_id": {
          "type": "string",
          "format": "uuid",
          "description": "Customer to notify. Optional for events published before this field existed."
        },
        "was_paid": {
          "type": "boolean",
          "description": "True only when the cancelled order had been paid and announced by order.placed. Absent or false means it was never paid."
        },
        "total_amount_minor": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "description": "Paid total from order.placed in the currency's minor unit. Present only when was_paid is true."
        },
        "currency": {
          "const": "THB",
          "description": "Present only when was_paid is true."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "flavor_id",
              "flavor_name",
              "portions",
              "unit_price_minor",
              "subtotal_minor"
            ],
            "properties": {
              "flavor_id": {
                "type": "string",
                "format": "uuid"
              },
              "flavor_name": {
                "type": "string",
                "minLength": 1
              },
              "portions": {
                "type": "integer",
                "minimum": 1
              },
              "unit_price_minor": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "subtotal_minor": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              }
            }
          },
          "description": "Same line items as order.placed. Present only when was_paid is true."
        },
        "paid_at": {
          "type": "string",
          "format": "date-time",
          "description": "Payment confirmation time. For orders paid after this field existed it equals the order.placed event time, so consumers can reverse the same daily bucket. Present only when was_paid is true."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "was_paid"
            ],
            "properties": {
              "was_paid": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "total_amount_minor",
              "currency",
              "items",
              "paid_at"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "total_amount_minor"
                  ]
                },
                {
                  "required": [
                    "currency"
                  ]
                },
                {
                  "required": [
                    "items"
                  ]
                },
                {
                  "required": [
                    "paid_at"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
