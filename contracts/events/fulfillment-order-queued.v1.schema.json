{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gelatoflow.example/contracts/events/fulfillment-order-queued.v1.schema.json",
  "title": "GelatoFlow OrderQueued v1 CloudEvent",
  "description": "Published by Fulfillment when it creates a ticket for a paid order and assigns its queue number.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "const": "/gelatoflow/fulfillment-service"
    },
    "type": {
      "const": "com.gelatoflow.fulfillment.order-queued.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_id",
        "customer_id",
        "queue_number",
        "pickup_slot_id",
        "pickup_at"
      ],
      "properties": {
        "order_id": {
          "type": "string",
          "format": "uuid"
        },
        "customer_id": {
          "type": "string",
          "format": "uuid",
          "description": "Customer who placed the order. Fulfillment does not publish this event for an order.placed without customer_id."
        },
        "queue_number": {
          "type": "string",
          "minLength": 1
        },
        "pickup_slot_id": {
          "type": "string",
          "format": "uuid"
        },
        "pickup_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
