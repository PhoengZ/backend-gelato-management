{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gelatoflow.example/contracts/events/fulfillment-order-ready.v1.schema.json",
  "title": "GelatoFlow OrderReady v1 CloudEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "const": "/gelatoflow/fulfillment-service"
    },
    "type": {
      "const": "com.gelatoflow.fulfillment.order-ready.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_id",
        "queue_number",
        "pickup_slot_id"
      ],
      "properties": {
        "order_id": {
          "type": "string",
          "format": "uuid"
        },
        "queue_number": {
          "type": "string",
          "minLength": 1
        },
        "pickup_slot_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
