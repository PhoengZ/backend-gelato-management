# Copy these values into your shell or deployment secret store; Spring does not load .env files.
# Obtain test credentials from Stripe and the webhook secret from `stripe listen`.
PORT=3007
PAYMENT_CHECKOUT_ENABLED=true
PAYMENT_GRPC_PORT=50057
PAYMENT_REQUEST_TOKEN=replace_with_distinct_order_to_payment_token_at_least_32_bytes
# Plaintext only for isolated local development. Configure PEM paths when TLS is enabled.
PAYMENT_GRPC_TLS=false
PAYMENT_GRPC_CERTIFICATE=
PAYMENT_GRPC_PRIVATE_KEY=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/payment/cancel
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_LIVE_MODE=false
PAYMENT_HTTP_CALLBACK_ENABLED=true
ORDER_HTTP_BASE_URL=http://localhost:3003
# Match Order's PAYMENT_SERVICE_TOKEN, distinct from PAYMENT_REQUEST_TOKEN.
PAYMENT_SERVICE_TOKEN=replace_with_shared_payment_to_order_token_at_least_32_bytes
PAYMENT_CALLBACK_ALLOW_PLAINTEXT=true
ORDER_HTTP_CALLBACK_TIMEOUT_MS=5000
JWT_SECRET=replace_with_auth_signing_secret_at_least_32_bytes
JWT_ISSUER=gelatoflow-auth
JWT_AUDIENCE=gelatoflow-api
ORDER_GRPC_TARGET=localhost:50054
ORDER_SERVICE_TOKEN=replace_with_dedicated_payment_machine_token
# Plaintext is for isolated local development only. TLS defaults to true.
ORDER_GRPC_TLS=false
ORDER_GRPC_DEADLINE_MS=5000
