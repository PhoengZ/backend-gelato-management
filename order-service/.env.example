PORT=3003
DATABASE_URL=host=localhost user=order_service password=order_db_dev_password dbname=gelatoflow_order port=5436 sslmode=disable
RABBITMQ_URL=amqp://order_service:order_dev_password@localhost:5672/gelato_vhost
BATCH_INVENTORY_GRPC_URL=localhost:50051
ORDER_SERVICE_TOKEN=replace_with_a_distinct_order_service_token_at_least_32_bytes
CATALOG_GRPC_URL=localhost:50052
PAYMENT_SERVICE_TOKEN=replace_with_a_shared_payment_service_token_at_least_32_bytes
# Order -> Payment gRPC; Payment must implement contracts/proto/payment/v1.
PAYMENT_GRPC_URL=127.0.0.1:50057
PAYMENT_REQUEST_TOKEN=replace_with_a_distinct_order_to_payment_token_at_least_32_bytes
PAYMENT_REQUEST_TIMEOUT=5s
