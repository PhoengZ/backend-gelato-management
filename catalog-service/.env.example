GO_ENV=development
PORT=3002
GRPC_ADDR=127.0.0.1:50052
REDIS_URL=redis://:catalog_dev_password@localhost:6380/0
REDIS_KEY_PREFIX=catalog:v1
JWT_SECRET=development_only_change_this_secret_32_bytes
JWT_ISSUER=gelatoflow-auth
JWT_AUDIENCE=gelatoflow-api
REQUEST_TIMEOUT=3s

# Optional HTTPS and gRPC TLS; each pair must be configured together.
HTTP_TLS_CERT_FILE=
HTTP_TLS_KEY_FILE=
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
