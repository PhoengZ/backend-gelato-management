# Core RabbitMQ Admin Credentials
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=secure_admin_password

# Microservices RabbitMQ URLs (for reference in application code)
RABBITMQ_URL_SERVICE_A=amqp://service_a:service_a_password@localhost:5672/service_a_vhost
RABBITMQ_URL_SERVICE_B=amqp://service_b:service_b_password@localhost:5672/service_b_vhost
