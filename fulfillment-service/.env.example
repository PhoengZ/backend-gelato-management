PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fulfillment?sslmode=disable

# optional — leave blank to run without RabbitMQ
# Shared dev broker (infra compose.dev.yml): vhost gelato_vhost, user from definitions.json.
RABBITMQ_URL=amqp://fulfillment_service:fulfillment_dev_password@localhost:5672/gelato_vhost

# Local JWT configuration
JWT_SECRET=development_only_change_this_secret_32_bytes
JWT_ISSUER=gelatoflow-auth
JWT_AUDIENCE=gelatoflow-api
